datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Currency {
  UZS
  USD
}

enum DebtStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum TransactionType {
  INCOMING_GOODS
  PAYMENT
  RETURN
}

enum ExpenseCategory {
  IJARA
  ELEKTR
  OYLIK
  XOJALIK
  SOLIQ
  BOSHQA
}

enum UserRole {
  OWNER
  SELLER
  SUPER_ADMIN
  STORE_OWNER
}

enum CashSource {
  TODAY_REGISTER
  SAFE
}

model User {
  id                    String    @id @default(uuid())
  telegramId            String    @unique
  phone                 String?
  fullName              String?
  name                  String?
  username              String?
  role                  String    @default("STORE_OWNER")
  status                String    @default("PENDING")
  subscriptionPlan      String?
  bonusDaysGranted      Int       @default(0)
  subscriptionExpiresAt DateTime?
  lastReminderSentAt    DateTime?
  approvedAt            DateTime?
  recoveryCodeHash      String?   @unique
  recoveryCodeCreatedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([role])
  @@index([subscriptionExpiresAt])
}

model SystemSettings {
  id                String   @id @default("global")
  paymentCardNumber String   @default("8600 0000 0000 0000")
  paymentCardHolder String   @default("ADMIN")
  monthlyPriceUzs   Decimal  @default(100000) @db.Decimal(18, 2)
  tariffInfoText    String?
  updatedAt         DateTime @default(now()) @updatedAt
}

model SubscriptionPayment {
  id               String   @id @default(cuid())
  userTelegramId   String
  amountUzs        Decimal  @default(0) @db.Decimal(18, 2)
  monthsGranted    Int      @default(1)
  bonusDaysGranted Int      @default(0)
  screenshotFileId String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  @@index([userTelegramId])
  @@index([status])
  @@index([createdAt])
}

model Supplier {
  id        String   @id @default(uuid())
  ownerId   String   @default("")
  name      String
  phone     String?
  debtUzs   Decimal  @default(0) @db.Decimal(18, 2)
  debtUsd   Decimal  @default(0) @db.Decimal(18, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices     Invoice[]
  invoiceItems InvoiceItem[]
  payments     SupplierPayment[]
  transactions SupplierTransaction[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([name])
  @@index([ownerId, isActive, debtUzs(sort: Desc)])
  @@index([ownerId, isActive, debtUsd(sort: Desc)])
}

model Product {
  id           String   @id @default(uuid())
  ownerId      String   @default("")
  name         String
  searchTokens String
  barcode      String?
  lastPrice    Decimal  @default(0) @db.Decimal(18, 2)
  currency     Currency @default(UZS)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoiceItems InvoiceItem[]

  @@index([ownerId])
  @@index([ownerId, name])
  @@index([name])
  @@index([searchTokens])
  @@index([updatedAt(sort: Desc)])
}

model Invoice {
  id                 String   @id @default(uuid())
  ownerId            String   @default("")
  invoiceNo          String?
  supplierId         String
  supplier           Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  totalAmount        Decimal  @db.Decimal(18, 2)
  originalAmount     Decimal? @db.Decimal(18, 2)
  discountAmount     Decimal? @db.Decimal(18, 2)
  currency           Currency @default(UZS)
  paymentType        String      @default("CREDIT")
  paymentSource      String      @default("TODAY_CASH")
  cashSource         CashSource?
  paidCashAmount     Decimal     @default(0) @db.Decimal(18, 2)
  creditAmount       Decimal     @default(0) @db.Decimal(18, 2)
  imageHash          String?     @db.VarChar(64)
  contentFingerprint String?     @db.VarChar(128)
  verbatimText       String?
  imageFileId        String?
  rawImageUrl        String?
  createdAt          DateTime    @default(now())

  items InvoiceItem[]

  @@index([ownerId])
  @@index([ownerId, imageHash])
  @@index([ownerId, contentFingerprint])
  @@index([ownerId, createdAt])
  @@index([ownerId, paymentSource, createdAt])
  @@index([ownerId, cashSource, createdAt])
  @@index([supplierId])
  @@index([createdAt])
  @@index([imageHash])
  @@index([contentFingerprint])
  @@index([paymentType, createdAt])
}

model InvoiceItem {
  id             String    @id @default(uuid())
  ownerId        String    @default("")
  invoiceId      String
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  rawName        String?
  normalizedName String?
  quantity       Decimal   @db.Decimal(12, 3)
  unit           String?   @default("dona")
  unitPrice      Decimal   @db.Decimal(18, 2)
  totalPrice     Decimal   @db.Decimal(18, 2)
  lineTotal      Decimal?  @db.Decimal(18, 2)
  currency       Currency  @default(UZS)
  createdAt      DateTime  @default(now())

  @@index([ownerId])
  @@index([ownerId, normalizedName])
  @@index([productId])
  @@index([invoiceId])
  @@index([supplierId])
  @@index([rawName])
  @@index([normalizedName])
  @@index([createdAt(sort: Desc)])
}

model SupplierPayment {
  id            String   @id @default(uuid())
  ownerId       String   @default("")
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(18, 2)
  currency      Currency @default(UZS)
  paymentSource String   @default("TODAY_CASH")
  comment       String?
  createdAt     DateTime @default(now())

  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([ownerId, paymentSource, createdAt])
  @@index([supplierId])
}

model SupplierTransaction {
  id               String          @id @default(uuid())
  ownerId          String          @default("")
  supplierId       String
  supplier         Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  invoiceId        String?
  type             TransactionType
  sourceType       String          @default("MANUAL")
  paymentSource    String          @default("TODAY_CASH")
  cashSource       CashSource?
  amount           Decimal         @db.Decimal(18, 2)
  originalAmount   Decimal?        @db.Decimal(18, 2)
  discountAmount   Decimal?        @db.Decimal(18, 2)
  currency         Currency        @default(UZS)
  date             DateTime        @default(now())
  receiptUrl       String?
  photoFileId      String?
  receiptData      Json?
  formattedReceipt String?
  description      String?

  @@index([ownerId])
  @@index([ownerId, date])
  @@index([ownerId, type, date])
  @@index([ownerId, paymentSource, date])
  @@index([supplierId])
  @@index([invoiceId])
  @@index([date])
  @@index([supplierId, date(sort: Desc)])
  @@index([supplierId, type, date])
}

model CustomerDebt {
  id           String     @id @default(uuid())
  ownerId      String     @default("")
  customerName String
  phone        String?
  itemsSummary String?
  amount       Decimal    @db.Decimal(18, 2)
  paidAmount   Decimal    @default(0) @db.Decimal(18, 2)
  currency     Currency   @default(UZS)
  status       DebtStatus @default(PENDING)
  dueDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([ownerId, createdAt])
  @@index([customerName])
  @@index([dueDate])
  @@index([status])
  @@index([status, customerName])
  @@index([status, createdAt])
}

model Expense {
  id        String   @id @default(uuid())
  ownerId   String   @default("")
  category  String   @default("Boshqa")
  amount    Decimal  @db.Decimal(18, 2)
  currency  Currency @default(UZS)
  note      String?
  createdAt DateTime @default(now())
  createdBy String?

  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([createdAt])
  @@index([category])
}

model CashTransaction {
  id            String      @id @default(uuid())
  ownerId       String      @default("")
  invoiceId     String?
  partyName     String
  amount        Decimal     @db.Decimal(18, 2)
  currency      Currency    @default(UZS)
  paymentSource String      @default("TODAY_CASH")
  cashSource    CashSource?
  items         String?
  createdAt     DateTime    @default(now())
  createdBy     String?

  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([ownerId, paymentSource, createdAt])
  @@index([ownerId, cashSource, createdAt])
  @@index([invoiceId])
  @@index([createdAt])
}

model DailyRegister {
  id                       String   @id @default(uuid())
  ownerId                  String   @default("")
  date                     DateTime @db.Date
  cashUzs                  Decimal  @default(0) @db.Decimal(18, 2)
  cashUsd                  Decimal  @default(0) @db.Decimal(18, 2)
  cashRemainingInDrawer    Decimal  @default(0) @db.Decimal(18, 2)
  clickAmount              Decimal  @default(0) @db.Decimal(18, 2)
  terminalAmount           Decimal  @default(0) @db.Decimal(18, 2)
  dailyCashPurchasesUzs    Decimal  @default(0) @db.Decimal(18, 2)
  dailySupplierPaymentsUzs Decimal  @default(0) @db.Decimal(18, 2)
  dailySupplierPaymentsUsd Decimal  @default(0) @db.Decimal(18, 2)
  totalDailySalesUzs       Decimal  @default(0) @db.Decimal(18, 2)
  isClosed                 Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([ownerId, date])
  @@index([ownerId])
}

model ZReport {
  id                       String   @id @default(uuid())
  ownerId                  String   @default("")
  date                     DateTime @db.Date
  terminalAmount           Decimal  @default(0) @db.Decimal(18, 2)
  clickAmount              Decimal  @default(0) @db.Decimal(18, 2)
  cashRemainingInDrawer    Decimal  @default(0) @db.Decimal(18, 2)
  dailyCashPurchasesUzs    Decimal  @default(0) @db.Decimal(18, 2)
  dailySupplierPaymentsUzs Decimal  @default(0) @db.Decimal(18, 2)
  dailySupplierPaymentsUsd Decimal  @default(0) @db.Decimal(18, 2)
  totalDailySalesUzs       Decimal  @default(0) @db.Decimal(18, 2)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([ownerId, date])
  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([date])
}

model AuditLog {
  id         String   @id @default(uuid())
  telegramId BigInt
  action     String
  details    Json
  createdAt  DateTime @default(now())

  @@index([telegramId])
  @@index([createdAt])
}

model Session {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model PendingAction {
  id        String   @id @default(uuid())
  userId    BigInt?
  type      String
  data      Json
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([userId, status, createdAt])
}

model ProcessedImage {
  id        String   @id @default(uuid())
  hash      String   @unique
  data      Json
  fileHash  String?
  fileId    String?
  createdAt DateTime @default(now())

  @@index([hash])
}
