datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Currency {
  UZS
  USD
}

enum DebtStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum TransactionType {
  INCOMING_GOODS
  PAYMENT
}

enum ExpenseCategory {
  IJARA
  ELEKTR
  OYLIK
  XOJALIK
  SOLIQ
  BOSHQA
}

enum UserRole {
  OWNER
  SELLER
}

model User {
  id         String   @id @default(uuid())
  telegramId BigInt   @unique
  name       String
  role       UserRole @default(SELLER)
  createdAt  DateTime @default(now())
}

model Supplier {
  id          String            @id @default(uuid())
  name        String            @unique
  phone       String?
  debtUzs     Decimal           @default(0) @db.Decimal(18, 2)
  debtUsd     Decimal           @default(0) @db.Decimal(18, 2)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  invoices    Invoice[]
  payments    SupplierPayment[]
  transactions SupplierTransaction[]

  @@index([name])
}

model Product {
  id           String        @id @default(uuid())
  name         String
  searchTokens String
  barcode      String?       @unique
  lastPrice    Decimal       @default(0) @db.Decimal(18, 2)
  currency     Currency      @default(UZS)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  invoiceItems InvoiceItem[]

  @@index([name])
  @@index([searchTokens])
}

model Invoice {
  id           String        @id @default(uuid())
  invoiceNo    String?
  supplierId   String
  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  totalAmount    Decimal       @db.Decimal(18, 2)
  originalAmount Decimal?      @db.Decimal(18, 2)
  discountAmount Decimal?      @db.Decimal(18, 2)
  currency       Currency      @default(UZS)
  rawImageUrl    String?
  createdAt      DateTime      @default(now())

  items        InvoiceItem[]

  @@index([supplierId])
  @@index([createdAt])
}

model InvoiceItem {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(12, 3)
  unitPrice  Decimal  @db.Decimal(18, 2)
  totalPrice Decimal  @db.Decimal(18, 2)
  currency   Currency @default(UZS)

  @@index([productId])
  @@index([invoiceId])
}

model SupplierPayment {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(18, 2)
  currency   Currency @default(UZS)
  comment    String?
  createdAt  DateTime @default(now())

  @@index([supplierId])
}

model SupplierTransaction {
  id               String          @id @default(uuid())
  supplierId       String
  supplier         Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type             TransactionType
  sourceType       String          @default("MANUAL")
  amount           Decimal         @db.Decimal(18, 2)
  originalAmount   Decimal?        @db.Decimal(18, 2)
  discountAmount   Decimal?        @db.Decimal(18, 2)
  currency         Currency        @default(UZS)
  date             DateTime        @default(now())
  receiptUrl       String?
  photoFileId      String?
  receiptData      Json?
  formattedReceipt String?
  description      String?

  @@index([supplierId])
  @@index([date])
}

model CustomerDebt {
  id           String     @id @default(uuid())
  customerName String
  phone        String?
  itemsSummary String?
  amount       Decimal    @db.Decimal(18, 2)
  paidAmount   Decimal    @default(0) @db.Decimal(18, 2)
  currency     Currency   @default(UZS)
  status       DebtStatus @default(PENDING)
  dueDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerName])
  @@index([dueDate])
  @@index([status])
}

model Expense {
  id        String          @id @default(uuid())
  category  String          @default("Boshqa")
  amount    Decimal         @db.Decimal(18, 2)
  currency  Currency        @default(UZS)
  note      String?
  createdAt DateTime        @default(now())
  createdBy String?

  @@index([createdAt])
  @@index([category])
}

model CashTransaction {
  id        String   @id @default(uuid())
  partyName String
  amount    Decimal  @db.Decimal(18, 2)
  items     String?
  createdAt DateTime @default(now())
  createdBy String?

  @@index([createdAt])
}

model DailyRegister {
  id             String   @id @default(uuid())
  date           DateTime @unique @db.Date
  cashUzs        Decimal  @default(0) @db.Decimal(18, 2)
  cashUsd        Decimal  @default(0) @db.Decimal(18, 2)
  clickAmount    Decimal  @default(0) @db.Decimal(18, 2)
  terminalAmount Decimal  @default(0) @db.Decimal(18, 2)
  isClosed       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  telegramId BigInt
  action     String
  details    Json
  createdAt  DateTime @default(now())

  @@index([telegramId])
  @@index([createdAt])
}

model Session {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model PendingAction {
  id        String   @id @default(uuid())
  userId    BigInt?
  type      String
  data      Json
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model ProcessedImage {
  id        String   @id @default(uuid())
  hash      String   @unique
  data      Json
  createdAt DateTime @default(now())
  
  @@index([hash])
}
